{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "file",
        "source": "/home/zistro/z-dotfiles/fastfetch/logo.txt",
        "color": {
            "1": "blue"
        }
    },
    "display": {
        "separator": "  ",
        "color" : {
            "keys": "light_cyan"
        },
    },
    "modules": [
        {   
            "type": "title",
            "key": " ",
            "color" : {
                "user": "light_cyan",
                "at": "white",
                "host": "light_blue"
            }
        },
        "break",
        {   
            "type": "os",
            "key": " 󰣇"
        },
        {  
            "type": "kernel",
            "key": " 󰻀",
            "format": "{sysname} {release}"
        },
        {   
            "type": "uptime",
            "key": " "
        },
        "break",
        {   
            "type": "command",
            "key": " 󱌔",
            "text": "cat /sys/devices/virtual/dmi/id/product_name",
            "shell" : "/bin/bash"
        },
        {   
            "type": "cpu",
            "key": " "
        },
        {   
            "type": "gpu",
            "key": " "
        },
        {  
            "type": "memory",
            "key" : " "
        },
        {   
            "type": "disk",
            "key": " "
        },
        {  
            "type": "display",
            "key": " 󰍹"
        },
        {   
            "type": "battery",
            "key": " "
        },
        {   
            "type": "gamepad",
            "key": " 󰺵"
        },
        "break",
        {   
            "type": "de",
            "key": " 󰇺"
        },
        {   
            "type": "wm",
            "key": " "
        },
        {   
            "type": "shell",
            "key": " "
        },
        {   
            "type": "terminal",
            "key": " "
        },
        {   
            "type": "packages",
            "key": " "
        },
        {   "type": "colors",
            "key": " ",
            "symbol": "circle"
        }
    ]
}
